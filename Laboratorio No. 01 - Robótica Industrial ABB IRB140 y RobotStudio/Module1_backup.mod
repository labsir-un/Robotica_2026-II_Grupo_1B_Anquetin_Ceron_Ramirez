            IF DI_02=1 THEN
                SET DO_02;
                Path_Man;
                RESET DO_02;
            ENDIF
            IF DI_03=1 THEN
                SET DO_03;
                Path_10;
                Path_Aura;
                Path_Aura;
                Path_Aura;
                Path_10;
                RESET DO_03;
            ENDIF
        ENDWHILE
